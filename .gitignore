# Python bytecode and packaging/build output: regenerated by the interpreter or `pip install .`, never committed.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# The default vault directory holds quarantined payloads (live malware samples) with permissions stripped; it must
# never reach version control. `*.tmp` covers temp files left by interrupted runs.
# Quarantine vaults and test artifacts
.quarantine_vault/
*.tmp
